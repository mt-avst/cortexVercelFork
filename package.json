{
  "name": "adaptalabs-root",
  "version": "7.4.0",
  "description": "Adaptalabs recruitment app root package",
  "private": true,
  "scripts": {
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "test:smoke": "playwright test e2e/production-smoke.test.ts --config=playwright.prod.config.ts",
    "test:admin-create-study": "playwright test e2e/superadmin-create-study.test.ts --config=playwright.superadmin.config.ts",
    "test:scripts": "node --test scripts/lib/pg-ssl.test.js scripts/set-superadmin.test.js scripts/role-scripts-tls.test.js",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:scripts && npm run test:e2e",
    "test:coverage": "cd backend && npm run test -- --coverage && cd ../frontend && npm run test -- --coverage",
    "lint": "eslint frontend/src backend/src backend/scripts shared scripts e2e",
    "lint:fix": "eslint frontend/src backend/src backend/scripts shared scripts e2e --fix",
    "lint:prune": "eslint frontend/src backend/src backend/scripts shared scripts e2e --prune-suppressions",
    "lint:suppress": "eslint frontend/src backend/src backend/scripts shared scripts e2e --suppress-all",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build:all": "cd backend && npm run build && cd ../frontend && npm run build",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "./start-dev.sh npm",
    "start:docker": "./start-dev.sh docker",
    "stop": "./start-dev.sh stop",
    "status": "./start-dev.sh status",
    "clean": "./start-dev.sh clean",
    "verify:prod": "node scripts/verify-production.mjs",
    "test:a11y:prod": "PLAYWRIGHT_NO_WEBSERVER=1 PRODUCTION_URL=https://adaptalabs.kubera-playground.adaptavist.net npx playwright test e2e/accessibility.test.ts --config=playwright.prod.config.ts --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.40.0",
    "@types/express": "^5.0.3",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "pg": "^8.11.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "lodash": "^4.18.0"
  }
}
