# Docker Development Environment Variables
# Copy this file to .env and customize as needed

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/adaptalabs_dev

# Server Configuration
NODE_ENV=development
PORT=3001
SESSION_SECRET=your-session-secret-here

# OIDC Configuration (replace with your actual values)
OIDC_ISSUER=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URL=http://localhost:3001/auth/callback

# Google Calendar API (replace with your actual values)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=primary

# Google OAuth (for user calendar integration - checking conflicts)
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/calendar/auth/callback

# Email Configuration (replace with your actual values)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-app-password
EMAIL_FROM=noreply@adaptalabs.com

# Application Configuration
APP_BASE_URL=http://localhost:3001
REACT_APP_API_URL=http://localhost:3001

# FirstHand Integration (optional — omit both to disable)
FIRSTHAND_BASE_URL=http://localhost:4000
FIRSTHAND_INTEGRATION_SECRET=your_shared_firsthand_secret_here_at_least_32_chars
