# Production Environment Variables for Docker Compose
# Copy this file to .env and update with your production values

# Database Configuration
POSTGRES_DB=adaptalabs_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=3001
DATABASE_URL=postgresql://postgres:your_secure_database_password@postgres:5432/adaptalabs_prod
SESSION_SECRET=your_very_secure_random_session_secret_here_minimum_32_characters
OIDC_ISSUER=https://your-production-idp.com
OIDC_CLIENT_ID=your_production_client_id
OIDC_CLIENT_SECRET=your_production_client_secret
OIDC_REDIRECT_URL=https://your-api-domain.com/auth/callback
ADMIN_EMAILS=admin1@company.com,admin2@company.com
CORS_ORIGIN=https://your-frontend-domain.com

# Email Configuration
EMAIL_FROM=noreply@yourcompany.com
EMAIL_FROM_NAME=Your Company Research Platform
EMAIL_SMTP_HOST=smtp.yourcompany.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@yourcompany.com
EMAIL_SMTP_PASS=your_smtp_password

# Google Calendar Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour production private key here\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=primary

# Google OAuth (for user calendar integration - checking conflicts)
GOOGLE_OAUTH_CLIENT_ID=your_production_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_production_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-api-domain.com/api/calendar/auth/callback

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_URL=https://your-frontend-domain.com
REACT_APP_API_URL=https://your-api-domain.com
REACT_APP_API_BASE_URL=https://your-api-domain.com
REACT_APP_AUTH_BASE_URL=https://your-api-domain.com
