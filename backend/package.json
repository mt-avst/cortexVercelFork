{
  "name": "adaptalabs-backend",
  "version": "7.4.0",
  "description": "Adaptalabs recruitment app backend",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "migrate": "node dist/backend/src/db/migrate.js",
    "seed": "node dist/backend/src/db/seed.js",
    "migrate:firsthand": "node scripts/firsthand-migrate.mjs",
    "reset-demo": "npx tsx src/db/reset-demo-data.ts",
    "reset-calendar": "npx tsx src/db/reset-calendar-bookings.ts",
    "reset-calendar-full": "npx tsx src/db/reset-calendar-bookings.ts --cancel-all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/lib-storage": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1088.0",
    "@types/cookie-parser": "^1.4.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openid-client": "^5.6.1",
    "pg": "^8.11.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.5",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
