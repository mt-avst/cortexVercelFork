{
  // Type-checks the backend INCLUDING its tests. tsconfig.json excludes them so
  // the build stays lean, which meant nothing ever checked them: a fixture
  // naming a field that does not exist compiled, ran, and reported green while
  // asserting nothing.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["node", "jest"] },
  // `probe/` is here for the same reason tests are. A measurement harness that
  // nothing type-checks rots exactly like an unchecked fixture, and the failure
  // is worse: it still runs, still prints a table, and the table is wrong.
  // Excluded from tsconfig.json's `include` so it never reaches the build.
  "include": ["src/**/*", "probe/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "dist"]
}
