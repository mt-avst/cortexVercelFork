{
  // `composite` makes this project emit, and with no outDir the emit lands next
  // to the source as vite.config.js + vite.config.d.ts. Vite resolves
  // vite.config.js BEFORE vite.config.ts, so that artefact silently shadows the
  // config it was compiled from: edit vite.config.ts, restart the dev server,
  // and nothing changes. A stale copy from a previous build shadows it with
  // OLD settings, which is worse. Emitting outside the project root keeps the
  // type-check and leaves vite.config.ts as the only config Vite can find.
  "compilerOptions": {
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}

